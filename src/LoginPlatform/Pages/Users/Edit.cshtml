@page "{id:int}"
@model LoginPlatform.Pages.Users.EditModel
@{ ViewData["Title"] = "Upravit uživatele"; }

<div class="col-md-5">
    <h1 class="h3 mb-3">Upravit uživatele</h1>
    <form method="post">
        <div class="mb-3">
            <label asp-for="Username" class="form-label">Uživatelské jméno</label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">Nové heslo (prázdné = beze změny)</label>
            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SelectedRole" class="form-label">Role</label>
            @if (Model.IsSelf)
            {
                <input class="form-control" value="@Model.SelectedRole" disabled />
                <input type="hidden" asp-for="SelectedRole" />
                <div class="form-text">Vlastní roli nelze změnit.</div>
            }
            else
            {
                <select asp-for="SelectedRole" asp-items="Model.RoleOptions" class="form-select"></select>
            }
            <span asp-validation-for="SelectedRole" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Uložit</button>
        <a asp-page="Index" class="btn btn-link">Zpět</a>
    </form>
</div>
