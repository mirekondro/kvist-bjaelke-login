@page "{id:int}"
@model LoginPlatform.Pages.Users.DeleteModel
@{ ViewData["Title"] = "Smazat uživatele"; }

<h1 class="h3 mb-3">Smazat uživatele</h1>

@if (Model.IsSelf)
{
    <div class="alert alert-warning">Nemůžete smazat sám sebe.</div>
    <a asp-page="Index" class="btn btn-link">Zpět</a>
}
else
{
    <p>Opravdu smazat uživatele <strong>@Model.Target!.Username</strong> (@Model.Target.Role)?</p>
    <form method="post">
        <button type="submit" class="btn btn-danger">Smazat</button>
        <a asp-page="Index" class="btn btn-link">Zpět</a>
    </form>
}
