@page
@model LoginPlatform.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Přihlášení";
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <h1 class="h3 mb-3">Přihlášení</h1>

        @if (Model.Error is not null)
        {
            <div class="alert alert-danger">@Model.Error</div>
        }

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Username" class="form-label">Uživatelské jméno</label>
                <input asp-for="Username" class="form-control" autocomplete="username" required />
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Heslo</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password"
                       required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Přihlásit</button>
        </form>
    </div>
</div>